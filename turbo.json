{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "src/generated/prisma/**"
      ],
      "env": ["NEXT_PUBLIC_API_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "PORT",
        "DATABASE_URL",
        "REDIS_URL",
        "JWT_ACCESS_SECRET",
        "NEXT_PUBLIC_API_URL",
        "JWT_ACCESS_TTL",
        "REFRESH_TOKEN_TTL",
        "NODE_ENV",
        "SLA_QUEUE_PREFIX",
        "OUTBOX_POLL_INTERVAL_MS"
      ]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false,
      "passThroughEnv": ["TEST_DATABASE_URL", "TEST_REDIS_URL"]
    },
    "clean": {
      "cache": false
    }
  }
}
